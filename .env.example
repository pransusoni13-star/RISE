# Use your computer's LAN IP for Expo Go on a physical phone during development.
# Production builds must use the HTTPS URL of the deployed RISE API.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Required for release preflight and App Store Connect metadata.
RISE_PRIVACY_POLICY_URL=https://rise-daily-skill-missions.vercel.app/privacy
RISE_PRIVACY_CHOICES_URL=https://rise-daily-skill-missions.vercel.app/privacy-choices
RISE_SUPPORT_URL=https://rise-daily-skill-missions.vercel.app/support
# Optional. Keep the current public TestFlight link unless Apple creates a new public group.
EXPO_PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/gwYy6GNr
