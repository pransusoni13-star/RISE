{
  "expo": {
    "name": "RISE",
    "slug": "RISE",
    "description": "Personalized daily missions for building career and life skills through focused action, reflection, and visible progress.",
    "version": "1.0.0",
    "backgroundColor": "#010807",
    "primaryColor": "#7AF5B8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rise",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#010807",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010807",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RISE accesses only the photo or video you choose as proof of a mission.",
          "cameraPermission": "RISE uses the camera only when you choose to capture mission proof.",
          "microphonePermission": "RISE uses the microphone only when you choose to record video proof."
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
