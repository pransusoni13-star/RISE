RISE_ENV=development
RISE_DATABASE_URL=sqlite:///./rise.db
RISE_JWT_SECRET=replace-with-at-least-32-random-characters
RISE_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8081
RISE_ACCESS_TOKEN_MINUTES=15
RISE_REFRESH_TOKEN_DAYS=30
RISE_FOUNDING_MEMBER_DAYS=365
RISE_FOUNDING_REDEMPTION_ENABLED=false
# A distinct random secret used only by the private admin analytics endpoint.
RISE_ADMIN_API_KEY=
# Public web URL used only to create password-reset links.
RISE_PUBLIC_APP_URL=https://your-rise-web-app.example
RISE_SUPPORT_EMAIL=rise.app13@gmail.com
# Private inbox for submitted beta feedback. It can differ from the public support address.
RISE_FEEDBACK_INBOX=rise.app13@gmail.com
# Select `smtp` only for an explicitly configured interim fallback.
RISE_EMAIL_PROVIDER=auto
# Preferred HTTPS email provider for hosts that block outbound SMTP. Keep the key in the host secret manager.
RISE_RESEND_API_KEY=
# Optional HTTPS-only sender for private feedback notifications. The Resend
# testing sender can deliver only to the email address on the Resend account.
RISE_RESEND_FROM_EMAIL=
RISE_EMAIL_FROM=RISE <onboarding@resend.dev>
# Optional SMTP fallback. Configure these through your hosting provider's secret manager.
RISE_SMTP_HOST=
RISE_SMTP_PORT=587
RISE_SMTP_USERNAME=
RISE_SMTP_PASSWORD=
RISE_SMTP_USE_TLS=true
